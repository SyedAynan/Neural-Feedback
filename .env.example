# Copy this file to .env and fill in your local values. Never commit .env.
# On Render/Railway, set these as real environment variables in the dashboard —
# config.php reads real env vars first, then falls back to this file.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=neural_feedback

# Aiven/managed MySQL only — set DB_SSL=1 if your provider requires TLS
DB_SSL=0
